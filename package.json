{
  "name": "imovel-pratico",
  "private": true,
  "version": "0.1.0",
  "description": "Plataforma de inteligência para captação imobiliária.",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "typecheck": "turbo typecheck",
    "typecheck:ci": "turbo run typecheck --force",
    "validate:pr": "bash scripts/validate-pr.sh",
    "setup:git-hooks": "git config core.hooksPath .githooks"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "prettier": "3.9.6",
    "turbo": "2.10.6",
    "typescript": "5.9.3"
  },
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": "24.18.0",
    "pnpm": "10.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ],
    "overrides": {
      "fast-uri@3.1.3": "3.1.4",
      "find-my-way@9.6.0": "9.7.0",
      "postcss@8.4.31": "8.5.23",
      "sharp@0.34.5": "0.35.3",
      "valibot@1.2.0": "1.4.2"
    }
  }
}
