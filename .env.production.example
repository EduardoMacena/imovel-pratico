# =========================================================
# Imóvel Prático — Produção
# Copie para .env.production no servidor e preencha os segredos.
# Nunca commitar .env.production real.
# =========================================================

NODE_ENV=production
APP_ENV=production

# URLs públicas
WEB_HOME_URL=https://imovelpratico.com
WEB_CLIENT_URL=https://app.imovelpratico.com
WEB_ADMIN_URL=https://admin.imovelpratico.com
API_URL=https://api.imovelpratico.com
NEXT_PUBLIC_API_URL=https://api.imovelpratico.com/api

# API Gateway
API_PORT=3333
JWT_SECRET=troque-este-jwt-secret-production-com-no-minimo-32-caracteres
TRUST_PROXY=true

CORS_ORIGINS=https://imovelpratico.com,https://app.imovelpratico.com,https://admin.imovelpratico.com

RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_TIME_WINDOW=1 minute
RATE_LIMIT_ESQUECI_SENHA_MAX=3
RATE_LIMIT_ESQUECI_SENHA_TIME_WINDOW=15 minutes
RATE_LIMIT_REDEFINIR_SENHA_MAX=5
RATE_LIMIT_REDEFINIR_SENHA_TIME_WINDOW=10 minutes
RATE_LIMIT_TROCAR_SENHA_MAX=5
RATE_LIMIT_TROCAR_SENHA_TIME_WINDOW=10 minutes

# Banco de dados produção
POSTGRES_DB=imovel_pratico_prod
POSTGRES_USER=imovel_pratico_prod
POSTGRES_PASSWORD=troque-esta-senha-production
DATABASE_URL=postgresql://imovel_pratico_prod:troque-esta-senha-production@postgres-prod:5432/imovel_pratico_prod?schema=public

# Redis produção
REDIS_URL=redis://redis-prod:6379

# SMTP produção
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=contato@imovelpratico.com
SMTP_PASS=troque-esta-senha-smtp
EMAIL_FROM=Imóvel Prático <contato@imovelpratico.com>
EMAIL_REPLY_TO=contato@imovelpratico.com

# Workers produção
WORKER_CLIENTE_ID=preencher-id-cliente-producao
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_SLOW_MO=0
REGISTRO_MIN_INTERVAL_SECONDS=30

# FonteData produção
FONTEDATA_ENABLED=false
FONTEDATA_API_KEY=
FONTEDATA_BASE_URL=https://app.fontedata.com/api/v1
