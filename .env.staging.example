# =========================================================
# Imóvel Prático — Staging
# Copie para .env.staging no servidor e preencha os segredos.
# Nunca commitar .env.staging real.
# =========================================================

NODE_ENV=production
APP_ENV=staging

# URLs públicas
WEB_HOME_URL=https://staging.imovelpratico.com
WEB_CLIENT_URL=https://app-staging.imovelpratico.com
WEB_ADMIN_URL=https://admin-staging.imovelpratico.com
API_URL=https://api-staging.imovelpratico.com
NEXT_PUBLIC_API_URL=https://api-staging.imovelpratico.com/api

# API Gateway
API_PORT=3333
JWT_SECRET=troque-este-jwt-secret-staging-com-no-minimo-32-caracteres
TRUST_PROXY=true

CORS_ORIGINS=https://staging.imovelpratico.com,https://app-staging.imovelpratico.com,https://admin-staging.imovelpratico.com

RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_TIME_WINDOW=1 minute
RATE_LIMIT_ESQUECI_SENHA_MAX=3
RATE_LIMIT_ESQUECI_SENHA_TIME_WINDOW=15 minutes
RATE_LIMIT_REDEFINIR_SENHA_MAX=5
RATE_LIMIT_REDEFINIR_SENHA_TIME_WINDOW=10 minutes
RATE_LIMIT_TROCAR_SENHA_MAX=5
RATE_LIMIT_TROCAR_SENHA_TIME_WINDOW=10 minutes

# Banco de dados staging
POSTGRES_DB=imovel_pratico_staging
POSTGRES_USER=imovel_pratico_staging
POSTGRES_PASSWORD=troque-esta-senha-staging
DATABASE_URL=postgresql://imovel_pratico_staging:troque-esta-senha-staging@postgres-staging:5432/imovel_pratico_staging?schema=public

# Redis staging
REDIS_URL=redis://redis-staging:6379

# SMTP staging
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=contato@imovelpratico.com
SMTP_PASS=troque-esta-senha-smtp
EMAIL_FROM=Imóvel Prático Staging <contato@imovelpratico.com>
EMAIL_REPLY_TO=contato@imovelpratico.com

# Workers staging
WORKER_CLIENTE_ID=preencher-id-cliente-staging
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_SLOW_MO=0
REGISTRO_MIN_INTERVAL_SECONDS=30

# FonteData staging
FONTEDATA_ENABLED=false
FONTEDATA_API_KEY=
FONTEDATA_BASE_URL=https://app.fontedata.com/api/v1
