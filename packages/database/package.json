{
  "name": "@imovel-pratico/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio --port 5555 --browser none",
    "db:seed": "tsx src/seed.ts",
    "db:seed:planos": "tsx src/seed-planos.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "echo \"lint database\"",
    "db:seed:super-admin": "tsx src/seed-super-admin.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.9.0",
    "@prisma/client": "7.9.0",
    "bcryptjs": "3.0.3",
    "dotenv": "17.4.2",
    "pg": "8.22.0"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "@types/pg": "8.20.0",
    "prisma": "7.9.0",
    "tsx": "4.23.1",
    "typescript": "7.0.2"
  }
}
