generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  moduleFormat           = "esm"
  runtime                = "nodejs"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

enum MunicipioStatus {
  EM_IMPLANTACAO
  EM_HOMOLOGACAO
  ATIVO
  INSTAVEL
  PAUSADO
  DESCONTINUADO
}

enum WorkerAgentInstallLinkStatus {
  PENDENTE
  USADO
  EXPIRADO
  CANCELADO
}

enum ClienteModoProcessamento {
  QUEUE
  AGENT
}

enum ClienteStatus {
  ATIVO
  INATIVO
  SUSPENSO
}

enum UsuarioRole {
  SUPER_ADMIN
  ADMIN
  GERENTE
  OPERADOR
}

enum TarefaStatus {
  PENDING
  PROCESSING
  COMPLETED
  ERROR
  CANCELED
}

enum ResultadoStatus {
  SUCCESS
  ERROR
}

enum CacheStatus {
  VALID
  EXPIRED
  UPDATING
  ERROR
}

enum PagamentoStatus {
  PAGO
  PENDENTE
  VENCIDO
  CANCELADO
}

enum PlanoStatus {
  ATIVO
  INATIVO
}

enum BuscaPreviaStatus {
  PENDENTE
  PROCESSANDO
  AGUARDANDO_INTERVALO
  CONSULTANDO_REGISTRO
  PRONTA
  AGUARDANDO_AUTORIZACAO_EXCEDENTE
  AUTORIZANDO
  CONFIRMADA
  CANCELADA
  EXPIRADA
  ERRO
}

enum FaturaStatus {
  ABERTA
  FECHADA
  PAGA
  VENCIDA
  CANCELADA
}

enum FaturaItemTipo {
  MENSALIDADE
  CONSULTA_EXCEDENTE
  AJUSTE
  DESCONTO
}

enum OperacaoEventoNivel {
  INFO
  WARN
  ERROR
}

enum OperacaoEventoServico {
  API_GATEWAY
  WORKER_REGISTRO
  WORKER_CND
  QUEUE
  REALTIME
}

enum WorkerHeartbeatStatus {
  ONLINE
  OFFLINE
  ERROR
}

enum WorkerAgentTipo {
  REGISTRO
  CND
}

enum WorkerAgentStatus {
  ATIVO
  INATIVO
  REVOGADO
}

model Municipio {
  id         String          @id @default(uuid())
  codigoIbge String          @unique
  nome       String
  uf         String
  status     MunicipioStatus @default(EM_IMPLANTACAO)

  configuracao Json?

  clientes      ClienteMunicipio[]
  tarefas       Tarefa[]
  buscasPrevias BuscaPrevia[]
  imoveisCache  ImovelCache[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([uf, nome])
  @@index([status])
  @@map("municipios")
}

model ClienteMunicipio {
  id String @id @default(uuid())

  clienteId   String
  municipioId String

  ativo     Boolean @default(true)
  principal Boolean @default(false)

  cliente   Cliente   @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  municipio Municipio @relation(fields: [municipioId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([clienteId, municipioId])
  @@index([municipioId])
  @@index([clienteId, ativo])
  @@map("cliente_municipios")
}

model Plano {
  id   String @id @default(uuid())
  nome String
  slug String @unique

  descricao String?

  limiteMensalConsultas          Int
  intervaloSegundos              Int
  precoCentavos                  Int
  valorConsultaAdicionalCentavos Int  @default(0)
  limiteCorretores               Int?

  status PlanoStatus @default(ATIVO)

  clientes Cliente[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("planos")
}

model Cliente {
  id     String        @id @default(uuid())
  nome   String
  slug   String        @unique
  status ClienteStatus @default(ATIVO)

  modoProcessamento ClienteModoProcessamento @default(QUEUE)

  planoId String?
  plano   Plano?  @relation(fields: [planoId], references: [id])

  workerUrl               String?
  intervaloSegundos       Int                      @default(60)
  workerAgentInstallLinks WorkerAgentInstallLink[]

  limiteDiario          Int             @default(300)
  limiteMensalConsultas Int             @default(300)
  pagamentoStatus       PagamentoStatus @default(PENDENTE)
  pagamentoVenceEm      DateTime?

  usuarios         Usuario[]
  tarefas          Tarefa[]
  consultasLogs    ConsultaLog[]
  operacaoEventos  OperacaoEvento[]
  workerHeartbeats WorkerHeartbeat[]
  workerAgents     WorkerAgent[]
  municipios       ClienteMunicipio[]

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  buscasPrevias BuscaPrevia[]
  faturas       Fatura[]

  @@index([planoId])
  @@map("clientes")
}

model Usuario {
  id        String @id @default(uuid())
  clienteId String

  nome  String
  email String      @unique
  senha String
  role  UsuarioRole @default(OPERADOR)

  ativo Boolean @default(true)

  precisaTrocarSenha Boolean   @default(false)
  senhaAlteradaEm    DateTime?

  resetSenhaTokenHash String?   @unique
  resetSenhaExpiraEm  DateTime?
  resetSenhaUsadoEm   DateTime?

  cliente Cliente @relation(fields: [clienteId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clienteId])
  @@map("usuarios")
}

model Tarefa {
  id            String       @id @default(uuid())
  clienteId     String
  buscaPreviaId String?
  status        TarefaStatus @default(PENDING)

  municipioId String    @default("31062000-0000-4000-8000-000000000001")
  municipio   Municipio @relation(fields: [municipioId], references: [id], onDelete: Restrict)

  logradouro String
  numero     String

  mesAnoInicio      String
  mesAnoFinal       String
  intervaloSegundos Int     @default(30)
  forceRefresh      Boolean @default(false)

  excedenteAutorizado            Boolean   @default(false)
  excedenteAutorizadoEm          DateTime?
  consultasEstimadas             Int?
  consultasDisponiveisNoMomento  Int?
  consultasExcedentesEstimadas   Int?
  valorConsultaAdicionalCentavos Int?
  valorExcedenteEstimadoCentavos Int?

  total   Int @default(0)
  current Int @default(0)

  erro String?

  cliente     Cliente           @relation(fields: [clienteId], references: [id])
  buscaPrevia BuscaPrevia?      @relation(fields: [buscaPreviaId], references: [id], onDelete: SetNull)
  resultados  TarefaResultado[]
  eventos     OperacaoEvento[]

  agentWorkerId      String?
  agentLeaseExpiraEm DateTime?
  agentTentativas    Int       @default(0)

  createdAt   DateTime  @default(now())
  startedAt   DateTime?
  completedAt DateTime?
  updatedAt   DateTime  @updatedAt

  @@index([clienteId])
  @@index([municipioId])
  @@index([status])
  @@index([agentWorkerId])
  @@index([agentLeaseExpiraEm])
  @@map("tarefas")
}

model BuscaPrevia {
  id String @id @default(uuid())

  clienteId String
  cliente   Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  municipioId String    @default("31062000-0000-4000-8000-000000000001")
  municipio   Municipio @relation(fields: [municipioId], references: [id], onDelete: Restrict)

  status BuscaPreviaStatus @default(PROCESSANDO)

  logradouro String
  numero     String

  quantidadeRegistros Int  @default(0)
  registros           Json @default("[]")

  consultasDisponiveisNoMomento  Int
  consultasExcedentesEstimadas   Int
  valorConsultaAdicionalCentavos Int
  valorExcedenteEstimadoCentavos Int

  workerUrl String?
  erro      String?

  expiraEm     DateTime
  confirmadaEm DateTime?

  tarefas Tarefa[]
  eventos OperacaoEvento[]

  agentWorkerId      String?
  agentLeaseExpiraEm DateTime?
  agentTentativas    Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clienteId])
  @@index([municipioId])
  @@index([status])
  @@index([expiraEm])
  @@index([agentWorkerId])
  @@index([agentLeaseExpiraEm])
  @@map("buscas_previas")
}

model Fatura {
  id String @id @default(uuid())

  clienteId String
  cliente   Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  status FaturaStatus @default(ABERTA)

  referenciaMes Int
  referenciaAno Int

  planoId   String?
  planoNome String?

  consultasInclusas   Int @default(0)
  consultasUsadas     Int @default(0)
  consultasExcedentes Int @default(0)

  valorMensalidadeCentavos       Int @default(0)
  valorConsultaAdicionalCentavos Int @default(0)
  valorExcedenteCentavos         Int @default(0)
  valorTotalCentavos             Int @default(0)

  vencimentoEm DateTime?
  pagaEm       DateTime?

  observacao String?

  itens FaturaItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([clienteId, referenciaMes, referenciaAno])
  @@index([clienteId])
  @@index([status])
  @@index([vencimentoEm])
  @@map("faturas")
}

model FaturaItem {
  id String @id @default(uuid())

  faturaId String
  fatura   Fatura @relation(fields: [faturaId], references: [id], onDelete: Cascade)

  tipo      FaturaItemTipo
  descricao String

  quantidade            Int @default(1)
  valorUnitarioCentavos Int
  valorTotalCentavos    Int

  createdAt DateTime @default(now())

  @@index([faturaId])
  @@map("fatura_itens")
}

model TarefaResultado {
  id       String          @id @default(uuid())
  tarefaId String
  status   ResultadoStatus

  logradouro      String
  numero          String
  complemento     String?
  indiceCadastral String

  nome     String?
  cpf      String?
  endereco String?
  telefone String?
  email    String?

  fonteContato String?
  dadosContato Json?

  erro String?

  tarefa Tarefa @relation(fields: [tarefaId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tarefaId])
  @@index([indiceCadastral])
  @@map("tarefa_resultados")
}

model ImovelCache {
  id String @id @default(uuid())

  municipioId String    @default("31062000-0000-4000-8000-000000000001")
  municipio   Municipio @relation(fields: [municipioId], references: [id], onDelete: Restrict)

  logradouro      String
  numero          String
  complemento     String?
  indiceCadastral String  @unique

  nome     String?
  cpf      String?
  endereco String?
  telefone String?
  email    String?

  fonteContato String?
  dadosContato Json?

  status CacheStatus @default(VALID)

  ultimaConsultaEm DateTime
  expiraEm         DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([municipioId, indiceCadastral])
  @@index([municipioId])
  @@index([indiceCadastral])
  @@index([expiraEm])
  @@map("imoveis_cache")
}

model ConsultaLog {
  id        String  @id @default(uuid())
  clienteId String?

  fonte String
  acao  String

  sucesso   Boolean
  duracaoMs Int?

  mensagemErro String?

  cliente Cliente? @relation(fields: [clienteId], references: [id])

  createdAt DateTime @default(now())

  @@index([clienteId])
  @@index([fonte])
  @@index([createdAt])
  @@map("consultas_logs")
}

model OperacaoEvento {
  id String @id @default(uuid())

  clienteId     String?
  tarefaId      String?
  buscaPreviaId String?

  nivel   OperacaoEventoNivel   @default(INFO)
  servico OperacaoEventoServico

  tipo     String
  mensagem String

  detalhes String?
  metadata Json?

  cliente     Cliente?     @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  tarefa      Tarefa?      @relation(fields: [tarefaId], references: [id], onDelete: SetNull)
  buscaPrevia BuscaPrevia? @relation(fields: [buscaPreviaId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([clienteId])
  @@index([tarefaId])
  @@index([buscaPreviaId])
  @@index([nivel])
  @@index([servico])
  @@index([tipo])
  @@index([createdAt])
  @@map("operacao_eventos")
}

model WorkerHeartbeat {
  id String @id @default(uuid())

  clienteId String
  cliente   Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  servico       OperacaoEventoServico
  identificador String
  fila          String?

  status WorkerHeartbeatStatus @default(ONLINE)

  ultimoSinalEm DateTime @default(now())
  metadata      Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([clienteId, servico, identificador])
  @@index([clienteId])
  @@index([servico])
  @@index([status])
  @@index([ultimoSinalEm])
  @@map("worker_heartbeats")
}

model WorkerAgent {
  id String @id @default(uuid())

  clienteId String
  cliente   Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  tipo          WorkerAgentTipo
  identificador String
  tokenHash     String          @unique

  status WorkerAgentStatus @default(ATIVO)

  ultimoSinalEm DateTime?
  metadata      Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([clienteId, tipo, identificador], name: "worker_agent_cliente_tipo_identificador_unique")
  @@index([clienteId])
  @@index([tipo])
  @@index([status])
  @@index([ultimoSinalEm])
  @@map("worker_agents")
}

model WorkerAgentInstallLink {
  id String @id @default(uuid())

  clienteId String
  cliente   Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  codigoHash String @unique

  status WorkerAgentInstallLinkStatus @default(PENDENTE)

  identificadorBase String
  incluirRegistro   Boolean @default(true)
  incluirCnd        Boolean @default(true)

  usadoEm  DateTime?
  expiraEm DateTime

  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clienteId])
  @@index([status])
  @@index([expiraEm])
  @@map("worker_agent_install_links")
}
