generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  runtime             = "nodejs"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

enum ClienteStatus {
  ATIVO
  INATIVO
  SUSPENSO
}

enum UsuarioRole {
  SUPER_ADMIN
  ADMIN
  GERENTE
  OPERADOR
}

enum TarefaStatus {
  PENDING
  PROCESSING
  COMPLETED
  ERROR
  CANCELED
}

enum ResultadoStatus {
  SUCCESS
  ERROR
}

enum CacheStatus {
  VALID
  EXPIRED
  UPDATING
  ERROR
}

enum PagamentoStatus {
  PAGO
  PENDENTE
  VENCIDO
  CANCELADO
}

enum PlanoStatus {
  ATIVO
  INATIVO
}

enum BuscaPreviaStatus {
  PENDENTE
  PROCESSANDO
  AGUARDANDO_INTERVALO
  CONSULTANDO_REGISTRO
  PRONTA
  AGUARDANDO_AUTORIZACAO_EXCEDENTE
  AUTORIZANDO
  CONFIRMADA
  CANCELADA
  EXPIRADA
  ERRO
}

enum FaturaStatus {
  ABERTA
  FECHADA
  PAGA
  VENCIDA
  CANCELADA
}

enum FaturaItemTipo {
  MENSALIDADE
  CONSULTA_EXCEDENTE
  AJUSTE
  DESCONTO
}

model Plano {
  id   String @id @default(uuid())
  nome String
  slug String @unique

  descricao String?

  limiteMensalConsultas          Int
  intervaloSegundos              Int
  precoCentavos                  Int
  valorConsultaAdicionalCentavos Int @default(0)
  limiteCorretores               Int?

  status PlanoStatus @default(ATIVO)

  clientes Cliente[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("planos")
}

model Cliente {
  id     String        @id @default(uuid())
  nome   String
  slug   String        @unique
  status ClienteStatus @default(ATIVO)

  planoId String?
  plano   Plano? @relation(fields: [planoId], references: [id])

  workerUrl         String?
  intervaloSegundos Int @default(60)

  limiteDiario            Int @default(300)
  limiteMensalConsultas   Int @default(300)
  pagamentoStatus         PagamentoStatus @default(PENDENTE)
  pagamentoVenceEm        DateTime?

  usuarios      Usuario[]
  tarefas       Tarefa[]
  consultasLogs ConsultaLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([planoId])
  @@map("clientes")
  buscasPrevias BuscaPrevia[]
  faturas Fatura[]
}

model Usuario {
  id        String      @id @default(uuid())
  clienteId String

  nome  String
  email String @unique
  senha String
  role  UsuarioRole @default(OPERADOR)

  ativo Boolean @default(true)

  precisaTrocarSenha Boolean @default(false)
  senhaAlteradaEm     DateTime?

  resetSenhaTokenHash String?   @unique
  resetSenhaExpiraEm   DateTime?
  resetSenhaUsadoEm    DateTime?

  cliente Cliente @relation(fields: [clienteId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clienteId])
  @@map("usuarios")
}

model Tarefa {
  id        String       @id @default(uuid())
  clienteId String
  buscaPreviaId String?
  status    TarefaStatus @default(PENDING)

  logradouro String
  numero     String

  mesAnoInicio      String
  mesAnoFinal       String
  intervaloSegundos Int     @default(30)
  forceRefresh      Boolean @default(false)

  excedenteAutorizado              Boolean   @default(false)
  excedenteAutorizadoEm            DateTime?
  consultasEstimadas               Int?
  consultasDisponiveisNoMomento    Int?
  consultasExcedentesEstimadas     Int?
  valorConsultaAdicionalCentavos   Int?
  valorExcedenteEstimadoCentavos   Int?

  total   Int @default(0)
  current Int @default(0)

  erro String?

  cliente    Cliente           @relation(fields: [clienteId], references: [id])
  buscaPrevia BuscaPrevia? @relation(fields: [buscaPreviaId], references: [id], onDelete: SetNull)
  resultados TarefaResultado[]

  createdAt   DateTime  @default(now())
  startedAt   DateTime?
  completedAt DateTime?
  updatedAt   DateTime  @updatedAt

  @@index([clienteId])
  @@index([status])
  @@map("tarefas")
}

model BuscaPrevia {
  id String @id @default(uuid())

  clienteId String
  cliente   Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  status BuscaPreviaStatus @default(PROCESSANDO)

  logradouro String
  numero     String

  quantidadeRegistros Int @default(0)
  registros            Json @default("[]")

  consultasDisponiveisNoMomento  Int
  consultasExcedentesEstimadas   Int
  valorConsultaAdicionalCentavos Int
  valorExcedenteEstimadoCentavos Int

  workerUrl String?
  erro      String?

  expiraEm     DateTime
  confirmadaEm DateTime?

  tarefas Tarefa[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clienteId])
  @@index([status])
  @@index([expiraEm])
  @@map("buscas_previas")
}

model Fatura {
  id String @id @default(uuid())

  clienteId String
  cliente   Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  status FaturaStatus @default(ABERTA)

  referenciaMes Int
  referenciaAno Int

  planoId   String?
  planoNome String?

  consultasInclusas   Int @default(0)
  consultasUsadas     Int @default(0)
  consultasExcedentes Int @default(0)

  valorMensalidadeCentavos       Int @default(0)
  valorConsultaAdicionalCentavos Int @default(0)
  valorExcedenteCentavos         Int @default(0)
  valorTotalCentavos             Int @default(0)

  vencimentoEm DateTime?
  pagaEm       DateTime?

  observacao String?

  itens FaturaItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([clienteId, referenciaMes, referenciaAno])
  @@index([clienteId])
  @@index([status])
  @@index([vencimentoEm])
  @@map("faturas")
}

model FaturaItem {
  id String @id @default(uuid())

  faturaId String
  fatura   Fatura @relation(fields: [faturaId], references: [id], onDelete: Cascade)

  tipo FaturaItemTipo
  descricao String

  quantidade Int @default(1)
  valorUnitarioCentavos Int
  valorTotalCentavos    Int

  createdAt DateTime @default(now())

  @@index([faturaId])
  @@map("fatura_itens")
}

model TarefaResultado {
  id       String          @id @default(uuid())
  tarefaId String
  status   ResultadoStatus

  logradouro      String
  numero          String
  complemento     String?
  indiceCadastral String

  nome     String?
  cpf      String?
  endereco String?
  telefone String?
  email    String?

  fonteContato String?
  dadosContato Json?

  erro String?

  tarefa Tarefa @relation(fields: [tarefaId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tarefaId])
  @@index([indiceCadastral])
  @@map("tarefa_resultados")
}

model ImovelCache {
  id String @id @default(uuid())

  logradouro      String
  numero          String
  complemento     String?
  indiceCadastral String @unique

  nome     String?
  cpf      String?
  endereco String?
  telefone String?
  email    String?

  fonteContato String?
  dadosContato Json?

  status CacheStatus @default(VALID)

  ultimaConsultaEm DateTime
  expiraEm         DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([indiceCadastral])
  @@index([expiraEm])
  @@map("imoveis_cache")
}

model ConsultaLog {
  id        String  @id @default(uuid())
  clienteId String?

  fonte String
  acao  String

  sucesso   Boolean
  duracaoMs Int?

  mensagemErro String?

  cliente Cliente? @relation(fields: [clienteId], references: [id])

  createdAt DateTime @default(now())

  @@index([clienteId])
  @@index([fonte])
  @@index([createdAt])
  @@map("consultas_logs")
}
