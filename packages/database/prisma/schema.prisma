generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  runtime             = "nodejs"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

enum ClienteStatus {
  ATIVO
  INATIVO
  SUSPENSO
}

enum UsuarioRole {
  SUPER_ADMIN
  ADMIN
  GERENTE
  OPERADOR
}

enum TarefaStatus {
  PENDING
  PROCESSING
  COMPLETED
  ERROR
  CANCELED
}

enum ResultadoStatus {
  SUCCESS
  ERROR
}

enum CacheStatus {
  VALID
  EXPIRED
  UPDATING
  ERROR
}

enum PagamentoStatus {
  PAGO
  PENDENTE
  VENCIDO
  CANCELADO
}

enum PlanoStatus {
  ATIVO
  INATIVO
}

model Plano {
  id   String @id @default(uuid())
  nome String
  slug String @unique

  descricao String?

  limiteMensalConsultas Int
  intervaloSegundos     Int
  precoCentavos         Int

  status PlanoStatus @default(ATIVO)

  clientes Cliente[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("planos")
}

model Cliente {
  id     String        @id @default(uuid())
  nome   String
  slug   String        @unique
  status ClienteStatus @default(ATIVO)

  planoId String?
  plano   Plano? @relation(fields: [planoId], references: [id])

  workerUrl         String?
  intervaloSegundos Int @default(60)

  limiteDiario            Int @default(300)
  limiteMensalConsultas   Int @default(300)
  pagamentoStatus         PagamentoStatus @default(PENDENTE)
  pagamentoVenceEm        DateTime?

  usuarios      Usuario[]
  tarefas       Tarefa[]
  consultasLogs ConsultaLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([planoId])
  @@map("clientes")
}

model Usuario {
  id        String      @id @default(uuid())
  clienteId String

  nome  String
  email String @unique
  senha String
  role  UsuarioRole @default(OPERADOR)

  ativo Boolean @default(true)

  cliente Cliente @relation(fields: [clienteId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clienteId])
  @@map("usuarios")
}

model Tarefa {
  id        String       @id @default(uuid())
  clienteId String
  status    TarefaStatus @default(PENDING)

  logradouro String
  numero     String

  mesAnoInicio      String
  mesAnoFinal       String
  intervaloSegundos Int     @default(30)
  forceRefresh      Boolean @default(false)

  total   Int @default(0)
  current Int @default(0)

  erro String?

  cliente    Cliente           @relation(fields: [clienteId], references: [id])
  resultados TarefaResultado[]

  createdAt   DateTime  @default(now())
  startedAt   DateTime?
  completedAt DateTime?
  updatedAt   DateTime  @updatedAt

  @@index([clienteId])
  @@index([status])
  @@map("tarefas")
}

model TarefaResultado {
  id       String          @id @default(uuid())
  tarefaId String
  status   ResultadoStatus

  logradouro      String
  numero          String
  complemento     String?
  indiceCadastral String

  nome     String?
  cpf      String?
  endereco String?
  telefone String?
  email    String?

  fonteContato String?
  dadosContato Json?

  erro String?

  tarefa Tarefa @relation(fields: [tarefaId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tarefaId])
  @@index([indiceCadastral])
  @@map("tarefa_resultados")
}

model ImovelCache {
  id String @id @default(uuid())

  logradouro      String
  numero          String
  complemento     String?
  indiceCadastral String @unique

  nome     String?
  cpf      String?
  endereco String?
  telefone String?
  email    String?

  fonteContato String?
  dadosContato Json?

  status CacheStatus @default(VALID)

  ultimaConsultaEm DateTime
  expiraEm         DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([indiceCadastral])
  @@index([expiraEm])
  @@map("imoveis_cache")
}

model ConsultaLog {
  id        String  @id @default(uuid())
  clienteId String?

  fonte String
  acao  String

  sucesso   Boolean
  duracaoMs Int?

  mensagemErro String?

  cliente Cliente? @relation(fields: [clienteId], references: [id])

  createdAt DateTime @default(now())

  @@index([clienteId])
  @@index([fonte])
  @@index([createdAt])
  @@map("consultas_logs")
}
