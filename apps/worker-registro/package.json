{
  "name": "@imovel-pratico/worker-registro",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx src/worker.ts",
    "dev:server": "tsx src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/worker.js",
    "start:server": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "echo \"lint worker-registro\"",
    "agent:dev": "tsx src/agent.ts",
    "agent:start": "node dist/agent.js"
  },
  "dependencies": {
    "@imovel-pratico/database": "workspace:*",
    "@imovel-pratico/queue": "workspace:*",
    "bullmq": "5.80.2",
    "dotenv": "17.4.2",
    "fastify": "5.10.0",
    "playwright": "1.61.1",
    "@imovel-pratico/agent-client": "workspace:*"
  },
  "devDependencies": {
    "tsx": "4.23.1",
    "typescript": "5.9.3"
  }
}
