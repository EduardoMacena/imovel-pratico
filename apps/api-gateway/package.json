{
  "name": "@imovel-pratico/api-gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "echo \"lint api-gateway\"",
    "worker-agent:create": "tsx src/scripts/create-worker-agent.ts"
  },
  "dependencies": {
    "@fastify/cors": "11.3.0",
    "@fastify/rate-limit": "11.1.0",
    "@fastify/websocket": "11.3.0",
    "@imovel-pratico/database": "workspace:*",
    "@imovel-pratico/queue": "workspace:*",
    "bcryptjs": "3.0.3",
    "dotenv": "17.4.2",
    "exceljs": "4.4.0",
    "fastify": "5.10.0",
    "jose": "6.2.3",
    "jsonwebtoken": "9.0.3",
    "nodemailer": "9.0.3",
    "pdfkit": "0.19.1",
    "pino": "10.3.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "26.1.1",
    "@types/nodemailer": "8.0.1",
    "@types/pdfkit": "0.17.6",
    "pino-pretty": "13.1.3",
    "tsx": "4.23.1",
    "typescript": "7.0.2"
  }
}
