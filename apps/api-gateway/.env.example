NODE_ENV=development
PORT=3333

DATABASE_URL="postgresql://user:password@localhost:5432/database?schema=public"
REDIS_URL="redis://localhost:6379"

JWT_SECRET="change-me-with-at-least-16-characters"

WEB_CLIENT_URL="http://localhost:3001"

SMTP_HOST="smtp.hostinger.com"
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER="contato@seudominio.com.br"
SMTP_PASS="sua-senha-do-email"

EMAIL_FROM="Imóvel Prático <contato@seudominio.com.br>"
EMAIL_REPLY_TO="contato@seudominio.com.br"

TRUST_PROXY=false

RATE_LIMIT_ENABLED=true

RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_TIME_WINDOW="1 minute"

RATE_LIMIT_ESQUECI_SENHA_MAX=3
RATE_LIMIT_ESQUECI_SENHA_TIME_WINDOW="15 minutes"

RATE_LIMIT_REDEFINIR_SENHA_MAX=5
RATE_LIMIT_REDEFINIR_SENHA_TIME_WINDOW="10 minutes"

RATE_LIMIT_TROCAR_SENHA_MAX=5
RATE_LIMIT_TROCAR_SENHA_TIME_WINDOW="10 minutes"

CORS_ORIGINS="http://localhost:3000,http://localhost:3001,http://localhost:3002"