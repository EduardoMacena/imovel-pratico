NODE_ENV=production
PORT=3333

DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"
REDIS_URL="redis://USER:PASSWORD@HOST:6379"

JWT_SECRET="troque-por-uma-chave-grande-com-mais-de-32-caracteres"

WEB_CLIENT_URL="https://app.imovelpratico.com.br"

CORS_ORIGINS="https://www.imovelpratico.com.br,https://admin.imovelpratico.com.br,https://app.imovelpratico.com.br"

TRUST_PROXY=true

SMTP_HOST="smtp.hostinger.com"
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER="contato@imovelpratico.com.br"
SMTP_PASS="senha-da-caixa-de-email"

EMAIL_FROM="Imóvel Prático <contato@imovelpratico.com.br>"
EMAIL_REPLY_TO="contato@imovelpratico.com.br"

RATE_LIMIT_ENABLED=true

RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_TIME_WINDOW="1 minute"

RATE_LIMIT_ESQUECI_SENHA_MAX=3
RATE_LIMIT_ESQUECI_SENHA_TIME_WINDOW="15 minutes"

RATE_LIMIT_REDEFINIR_SENHA_MAX=5
RATE_LIMIT_REDEFINIR_SENHA_TIME_WINDOW="10 minutes"

RATE_LIMIT_TROCAR_SENHA_MAX=5
RATE_LIMIT_TROCAR_SENHA_TIME_WINDOW="10 minutes"