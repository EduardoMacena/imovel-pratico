{
  "name": "@imovel-pratico/agent-windows",
  "private": true,
  "version": "0.1.0",
  "main": "dist/main.js",
  "description": "Agent local do Imóvel Prático para instalação e execução no Windows.",
  "scripts": {
    "build:agent-client": "pnpm --filter @imovel-pratico/agent-client build",
    "build:workers": "node scripts/build-workers.mjs",
    "build": "pnpm build:agent-client && pnpm build:workers && tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "dev": "pnpm build && electron .",
    "dist:win": "pnpm build && electron-builder --win nsis",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "playwright": "1.61.1"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "electron": "43.2.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.27.7",
    "typescript": "5.9.3"
  },
  "build": {
    "appId": "com.imovelpratico.agent",
    "productName": "Imóvel Prático Agent",
    "asar": false,
    "directories": {
      "output": "dist-installer",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Imóvel Prático Agent",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    }
  }
}
